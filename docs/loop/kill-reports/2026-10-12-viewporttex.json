+#[test]
+fn vertex_stays_32_bytes_with_the_uv_slot() {
+    // The uv replaced the old `_pad` in place: stride is unchanged,
+    // so the OpenPBR pipeline (locations 0–1) needs no update.
+    assert_eq!(size_of::<Vertex>(), 32);
