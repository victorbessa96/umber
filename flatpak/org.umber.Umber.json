{
    "app-id": "org.umber.Umber",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "umber",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--talk-name=org.freedesktop.portal.*",
        "--talk-name=org.a11y.Bus",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-pictures"
    ],
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man"
    ],
    "modules": [
        {
            "name": "umber",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/victorbessa96/umber",
                    "branch": "master"
                },
                {
                    "type": "file",
                    "path": "org.umber.Umber.desktop"
                },
                {
                    "type": "file",
                    "path": "org.umber.Umber.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "org.umber.Umber.svg"
                }
            ],
            "build-commands": [
                "cargo --locked build --release -p umber-app",
                "install -Dm755 target/release/umber /app/bin/umber",
                "install -Dm644 org.umber.Umber.desktop /app/share/applications/org.umber.Umber.desktop",
                "install -Dm644 org.umber.Umber.metainfo.xml /app/share/metainfo/org.umber.Umber.metainfo.xml",
                "install -Dm644 org.umber.Umber.svg /app/share/icons/hicolor/scalable/apps/org.umber.Umber.svg"
            ]
        }
    ]
}
