{
  "name": "Matte plastic",
  "version": 1,
  "layers": [
    {
      "name": "Plastic folder",
      "kind": "folder"
    },
    {
      "name": "Plastic base",
      "kind": "fill",
      "blend_mode": "Normal",
      "opacity": 1.0,
      "generator": {
        "node_def": "mesh_map_generator",
        "map_name": "AO",
        "channel": "baseColor"
      }
    },
    {
      "name": "Micro speckle",
      "kind": "fill",
      "blend_mode": "Multiply",
      "opacity": 0.3,
      "generator": {
        "node_def": "noise_value",
        "map_name": "",
        "channel": "roughness"
      }
    },
    {
      "name": "Rim highlight",
      "kind": "fill",
      "blend_mode": "Screen",
      "opacity": 0.4,
      "generator": {
        "node_def": "mesh_map_generator",
        "map_name": "curvature",
        "channel": "baseColor"
      }
    }
  ]
}
