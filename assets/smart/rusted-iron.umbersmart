{
  "name": "Rusted iron",
  "version": 1,
  "layers": [
    {
      "name": "Iron folder",
      "kind": "folder",
      "blend_mode": "Normal",
      "opacity": 1.0,
      "mask": null,
      "generator": null
    },
    {
      "name": "Iron base",
      "kind": "fill",
      "blend_mode": "Normal",
      "opacity": 1.0,
      "mask": null,
      "generator": {
        "node_def": "mesh_map_generator",
        "map_name": "AO",
        "channel": "metallic",
        "param": "oxide-mode"
      }
    },
    {
      "name": "Rust patches",
      "kind": "fill",
      "blend_mode": "Overlay",
      "opacity": 0.85,
      "mask": "Rust mask",
      "generator": {
        "node_def": "noise_perlin",
        "map_name": "",
        "channel": "baseColor",
        "param": "rust-coverage"
      }
    },
    {
      "name": "Edge rust",
      "kind": "fill",
      "blend_mode": "Multiply",
      "opacity": 0.6,
      "mask": null,
      "generator": {
        "node_def": "mesh_map_generator",
        "map_name": "curvature",
        "channel": "baseColor"
      }
    }
  ],
  "parameters": [
    {
      "id": "rust-coverage",
      "label": "Rust coverage",
      "kind": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.55
      }
    },
    {
      "id": "oxide-mode",
      "label": "Oxide mode",
      "kind": {
        "type": "choice",
        "options": [
          "metal",
          "oxide"
        ],
        "default": "metal"
      }
    }
  ]
}
