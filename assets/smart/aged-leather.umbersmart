{
  "name": "Aged leather",
  "version": 1,
  "layers": [
    {
      "name": "Leather folder",
      "kind": "folder",
      "blend_mode": "Normal",
      "opacity": 1.0,
      "mask": null,
      "generator": null
    },
    {
      "name": "Leather base",
      "kind": "fill",
      "blend_mode": "Normal",
      "opacity": 1.0,
      "mask": null,
      "generator": {
        "node_def": "noise_worley",
        "map_name": "",
        "channel": "baseColor",
        "param": "roughness"
      }
    },
    {
      "name": "Creases",
      "kind": "fill",
      "blend_mode": "Overlay",
      "opacity": 0.75,
      "mask": "Crease mask",
      "generator": {
        "node_def": "mesh_map_generator",
        "map_name": "curvature",
        "channel": "roughness",
        "param": "wear"
      }
    },
    {
      "name": "Patina",
      "kind": "paint",
      "blend_mode": "Screen",
      "opacity": 0.35,
      "mask": null,
      "generator": null
    }
  ],
  "parameters": [
    {
      "id": "wear",
      "label": "Wear amount",
      "kind": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.35
      }
    },
    {
      "id": "roughness",
      "label": "Grain roughness",
      "kind": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.6
      }
    }
  ]
}
