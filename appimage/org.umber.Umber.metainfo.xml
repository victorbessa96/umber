  <name>Umber</name>
  <summary>Open-source Rust-native 3D texture painting</summary>
  <description>
    <p>
      Umber is a free, local-first 3D texture-painting application in the
      Substance Painter class: paint PBR materials directly on your meshes,
      build non-destructive layer stacks, bake mesh maps, and export
      engine-ready texture sets. Written in Rust on wgpu (Vulkan).
    </p>
  </description>
  <launchable type="desktop-id">org.umber.Umber.desktop</launchable>
  <url type="homepage">https://github.com/victorbessa96/umber</url>
  <developer_name>Umber contributors</developer_name>
