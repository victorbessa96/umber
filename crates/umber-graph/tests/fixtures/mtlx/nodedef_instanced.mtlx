<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shape: standalone nodedef + implementation nodegraph + instance (kill A).
  Source claims (docs/research/materialx-roundtrip.md):
    2.5.6 foreign nodedefs carry version / isdefaultversion, UI metadata
          (uiname, uifolder, doc, uimin/uimax) and a nodegraph body bound
          by nodedef=;
    1.3.2 standalone files may carry the full nodedef + instancing shape;
    3.4.3 a node may request a specific nodedef version (kept as data);
    4.2.1 nesting deeper than 1 exists in hand-built libraries;
    4.2.3 interfacename binds an inner input to the enclosing interface.
  Hand-authored from those documented behaviors, NOT a corpus file (7 Q1).
-->
<materialx version="1.39">
  <nodedef name="ND_rust_mask_float" node="rust_mask" nodegroup="texture2d" version="2.0" isdefaultversion="true" doc="Rust coverage mask.">
    <input name="amount" type="float" value="0.5" uimin="0.0" uimax="1.0" uiname="Amount" uifolder="Rust" />
    <input name="seed" type="integer" value="7" />
    <output name="out" type="float" />
  </nodedef>
  <nodegraph name="NG_rust_mask_float" nodedef="ND_rust_mask_float">
    <nodegraph name="NG_inner">
      <input name="amount" type="float" value="0.5" />
      <noise2d name="inner_noise" type="float">
        <input name="amplitude" type="float" interfacename="amount" />
      </noise2d>
      <output name="out" type="float" nodename="inner_noise" />
    </nodegraph>
    <clamp name="clamped" type="float">
      <input name="in" type="float" nodegraph="NG_inner" output="out" />
    </clamp>
    <output name="out" type="float" nodename="clamped" />
  </nodegraph>
  <rust_mask name="rust1" type="float" version="2.0">
    <input name="amount" type="float" value="0.8" />
  </rust_mask>
  <open_pbr_surface name="Shader" type="surfaceshader">
    <input name="specular_roughness" type="float" nodename="rust1" />
  </open_pbr_surface>
</materialx>
