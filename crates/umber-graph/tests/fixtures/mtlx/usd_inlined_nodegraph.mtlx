<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shape: USD-path group contents inlined as a bare nodegraph (kill A).
  Source claims (docs/research/materialx-roundtrip.md):
    1.3.2 USD-embedded MaterialX writes each group's contents as a
          nodegraph without nodedef instancing (flat skew, no identity);
    1.2.3 UsdMtlxRead does not perform nodegraphs, so depth stays 1;
    2.5.1 the shader reads the graph through nodegraph= + output=.
  Hand-authored from those documented behaviors, NOT a corpus file (7 Q1).
-->
<materialx version="1.39">
  <nodegraph name="NG_Group">
    <image name="mask_image" type="float">
      <input name="file" type="filename" value="textures/mask.png" />
    </image>
    <invert name="mask_invert" type="float">
      <input name="in" type="float" nodename="mask_image" />
    </invert>
    <output name="out" type="float" nodename="mask_invert" />
  </nodegraph>
  <open_pbr_surface name="Shader" type="surfaceshader">
    <input name="specular_roughness" type="float" nodegraph="NG_Group" output="out" />
  </open_pbr_surface>
  <surfacematerial name="Material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Shader" />
  </surfacematerial>
</materialx>
